# 기본값으로 실행할 때는 이 파일만으로 충분하다.
# 값을 변경하려면 사용자가 직접 이 파일을 .env로 복사해 수정한다.
API_PORT=8000
WEB_PORT=5173
SENSOR_STALE_SECONDS=60
CLASSROOM_STATE_DIR=/app/state
# 시설 검증 전 시연용 순찰 참고 기준. 습도는 조건에 사용하지 않는다.
LIGHT_CHECK_MIN_LUX=300
LIGHT_CHECK_MAX_CO2_PPM=650
LIGHT_CHECK_HOLD_SECONDS=600
LIGHT_CHECK_MAX_GAP_SECONDS=120
# 독립 CSV 생성기. simulation-tools 프로필로만 실행하며 기존 학습 CSV에 합치지 않는다.
SIM_SEED=20261111
SIM_ROOMS=3
SIM_DAYS=7
SIM_START_DATE=2026-11-09
SIM_TIMEZONE=Asia/Seoul
SIM_STEP_SECONDS=60
SIM_MODE=exceptions
SIM_CAPACITY=8
SIM_VOLUME_M3=90
SIM_EVENT_PROBABILITY=0.03
SIM_LATITUDE=37.5
